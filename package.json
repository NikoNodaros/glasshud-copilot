{
  "name": "glasshud-copilot",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Clean-room desktop AI overlay assistant with screenshot vision, live audio transcription, and BYOK streaming for OpenAI, Anthropic, and Google Gemini.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "mkdir -p resources/bin /tmp/swift-module-cache && swiftc -O -parse-as-library -module-cache-path /tmp/swift-module-cache native/mac-audio-capture/main.swift -o resources/bin/mac-audio-capture -framework CoreAudio -framework AudioToolbox -framework Foundation",
    "build:all": "npm run build:native && npm run build",
    "package:mac": "npm run build:all && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "fix:electron": "node scripts/fix-electron.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron ."
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.1.1"
  }
}
